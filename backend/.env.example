PORT=4000
DB_PATH=./data/config.db
# Generate with: openssl rand -base64 32   (keep it safe: losing it means re-entering every token)
ENCRYPTION_KEY=

# Auth: local (users + sessions) or off (demo only — everyone is admin, name from x-user)
AUTH_MODE=local
# First start with an empty DB creates this admin (or run: npm run user:create -- <name> admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
SESSION_HOURS=12
# Behind HTTPS set COOKIE_SECURE=true; behind a proxy / ingress set TRUST_PROXY=1
COOKIE_SECURE=false
TRUST_PROXY=

# Dev: the Vite server on :5173 proxies /api, so this only matters if you call the API from elsewhere
CORS_ORIGIN=http://localhost:5173
# Production: path of the built frontend (the Docker image sets this to /app/public)
STATIC_DIR=
